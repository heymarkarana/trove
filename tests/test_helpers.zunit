#!/usr/bin/env zunit

@setup {
  # Source the helpers library
  source "${TROVE_HOME}/lib/trove_helpers.zsh"

  # Create temporary test directory
  TROVE_TEST_DIR="/tmp/trove_test_$$"
  mkdir -p "${TROVE_TEST_DIR}"
}

@teardown {
  # Clean up test directory
  rm -rf "${TROVE_TEST_DIR}"
}

# Path validation tests

@test 'trove_path_exists returns true for existing path' {
  touch "${TROVE_TEST_DIR}/testfile"

  run trove_path_exists "${TROVE_TEST_DIR}/testfile"

  assert $state equals 0
}

@test 'trove_path_exists returns false for non-existent path' {
  run trove_path_exists "${TROVE_TEST_DIR}/nonexistent"

  assert $state equals 1
}

@test 'trove_is_directory returns true for directory' {
  run trove_is_directory "${TROVE_TEST_DIR}"

  assert $state equals 0
}

@test 'trove_is_directory returns false for file' {
  touch "${TROVE_TEST_DIR}/testfile"

  run trove_is_directory "${TROVE_TEST_DIR}/testfile"

  assert $state equals 1
}

@test 'trove_is_file returns true for file' {
  touch "${TROVE_TEST_DIR}/testfile"

  run trove_is_file "${TROVE_TEST_DIR}/testfile"

  assert $state equals 0
}

@test 'trove_is_file returns false for directory' {
  run trove_is_file "${TROVE_TEST_DIR}"

  assert $state equals 1
}

# Permission tests

@test 'trove_is_readable returns true for readable file' {
  touch "${TROVE_TEST_DIR}/readable"
  chmod 644 "${TROVE_TEST_DIR}/readable"

  run trove_is_readable "${TROVE_TEST_DIR}/readable"

  assert $state equals 0
}

@test 'trove_is_writable returns true for writable file' {
  touch "${TROVE_TEST_DIR}/writable"
  chmod 644 "${TROVE_TEST_DIR}/writable"

  run trove_is_writable "${TROVE_TEST_DIR}/writable"

  assert $state equals 0
}

@test 'trove_is_executable returns true for executable file' {
  touch "${TROVE_TEST_DIR}/executable"
  chmod 755 "${TROVE_TEST_DIR}/executable"

  run trove_is_executable "${TROVE_TEST_DIR}/executable"

  assert $state equals 0
}

@test 'trove_is_executable returns false for non-executable file' {
  touch "${TROVE_TEST_DIR}/notexec"
  chmod 644 "${TROVE_TEST_DIR}/notexec"

  run trove_is_executable "${TROVE_TEST_DIR}/notexec"

  assert $state equals 1
}

# Platform detection tests

@test 'trove_is_macos returns correct value' {
  if [[ "$(uname -s)" == "Darwin" ]]; then
    run trove_is_macos
    assert $state equals 0
  else
    run trove_is_macos
    assert $state equals 1
  fi
}

@test 'trove_is_linux returns correct value' {
  if [[ "$(uname -s)" == "Linux" ]]; then
    run trove_is_linux
    assert $state equals 0
  else
    run trove_is_linux
    assert $state equals 1
  fi
}

@test 'trove_get_platform returns operating system' {
  run trove_get_platform

  assert $state equals 0
  assert "$output" is_not_empty
}

# Command detection tests

@test 'trove_command_exists returns true for existing command' {
  run trove_command_exists "ls"

  assert $state equals 0
}

@test 'trove_command_exists returns false for non-existent command' {
  run trove_command_exists "nonexistent_command_12345"

  assert $state equals 1
}

@test 'trove_require_command succeeds for existing command' {
  run trove_require_command "ls"

  assert $state equals 0
}

@test 'trove_require_command fails for non-existent command' {
  run trove_require_command "nonexistent_command_12345"

  assert $state equals 1
  assert "$output" contains "Command not found"
}

# Environment variable tests

@test 'trove_is_set returns true for set variable' {
  export TROVE_TEST_VAR="value"

  run trove_is_set "TROVE_TEST_VAR"

  assert $state equals 0
}

@test 'trove_is_set returns false for unset variable' {
  unset TROVE_TEST_VAR

  run trove_is_set "TROVE_TEST_VAR"

  assert $state equals 1
}

@test 'trove_require_vars succeeds when all vars set' {
  export TROVE_VAR1="value1"
  export TROVE_VAR2="value2"

  run trove_require_vars "TROVE_VAR1" "TROVE_VAR2"

  assert $state equals 0
}

@test 'trove_require_vars fails when var missing' {
  export TROVE_VAR1="value1"
  unset TROVE_VAR2

  run trove_require_vars "TROVE_VAR1" "TROVE_VAR2"

  assert $state equals 1
  assert "$output" contains "Missing required"
}

@test 'trove_get_env returns variable value' {
  export TROVE_TEST_VAR="test_value"

  run trove_get_env "TROVE_TEST_VAR"

  assert $state equals 0
  assert "$output" same_as "test_value"
}

@test 'trove_get_env returns default for unset variable' {
  unset TROVE_TEST_VAR

  run trove_get_env "TROVE_TEST_VAR" "default_value"

  assert $state equals 0
  assert "$output" same_as "default_value"
}

# String utility tests

@test 'trove_trim removes leading and trailing whitespace' {
  run trove_trim "  hello world  "

  assert $state equals 0
  assert "$output" same_as "hello world"
}

@test 'trove_lowercase converts to lowercase' {
  run trove_lowercase "HELLO WORLD"

  assert $state equals 0
  assert "$output" same_as "hello world"
}

@test 'trove_uppercase converts to uppercase' {
  run trove_uppercase "hello world"

  assert $state equals 0
  assert "$output" same_as "HELLO WORLD"
}

@test 'trove_starts_with returns true for matching prefix' {
  run trove_starts_with "hello world" "hello"

  assert $state equals 0
}

@test 'trove_starts_with returns false for non-matching prefix' {
  run trove_starts_with "hello world" "world"

  assert $state equals 1
}

@test 'trove_ends_with returns true for matching suffix' {
  run trove_ends_with "hello world" "world"

  assert $state equals 0
}

@test 'trove_ends_with returns false for non-matching suffix' {
  run trove_ends_with "hello world" "hello"

  assert $state equals 1
}

# trove_contains doesn't exist in the helpers library
# Removing these tests as the function is not implemented

###############################################################################
# Portable stat helpers (added for v1.0 — used by dotFiles df_perms/heal)
###############################################################################

@test 'trove_stat_owner returns the owning username' {
  touch "${TROVE_TEST_DIR}/ownedfile"
  run trove_stat_owner "${TROVE_TEST_DIR}/ownedfile"
  assert $state equals 0
  assert "$output" same_as "$(id -un)"
}

@test 'trove_stat_owner fails for a missing path' {
  run trove_stat_owner "${TROVE_TEST_DIR}/nope"
  assert $state equals 1
}

@test 'trove_stat_mode returns octal permission bits' {
  touch "${TROVE_TEST_DIR}/modefile"
  chmod 640 "${TROVE_TEST_DIR}/modefile"
  run trove_stat_mode "${TROVE_TEST_DIR}/modefile"
  assert "$output" same_as '640'
}

@test 'trove_stat_mode reflects a changed mode' {
  touch "${TROVE_TEST_DIR}/modefile2"
  chmod 600 "${TROVE_TEST_DIR}/modefile2"
  run trove_stat_mode "${TROVE_TEST_DIR}/modefile2"
  assert "$output" same_as '600'
}

@test 'trove_stat_mode reports the sticky special bit (OI-3 high-bit regression)' {
  # The setgid invariant (conventions §6) needs the HIGH bits preserved — the BSD
  # %Lp bug this helper works around dropped them. Sticky (1000) is a high bit that
  # reliably sticks even on macOS /tmp (unlike setgid, which /tmp strips), so it's
  # the deterministic regression for "high bits are not dropped".
  mkdir -p "${TROVE_TEST_DIR}/sticky"
  chmod 1777 "${TROVE_TEST_DIR}/sticky"
  run trove_stat_mode "${TROVE_TEST_DIR}/sticky"
  assert "$output" same_as '1777'
}

@test 'trove_stat_mode reports the setgid special bit when the FS keeps it' {
  mkdir -p "${TROVE_TEST_DIR}/sgid"
  chmod 2755 "${TROVE_TEST_DIR}/sgid"
  # Some sandboxed filesystems (macOS /tmp) strip setgid on chmod; only assert
  # when it actually stuck (-g tests the setgid bit) — the sticky test covers the
  # high-bit path regardless.
  if [[ -g "${TROVE_TEST_DIR}/sgid" ]]; then
    run trove_stat_mode "${TROVE_TEST_DIR}/sgid"
    assert "$output" same_as '2755'
  fi
}

@test 'trove_stat_group returns the owning group' {
  touch "${TROVE_TEST_DIR}/groupfile"
  run trove_stat_group "${TROVE_TEST_DIR}/groupfile"
  assert "$output" is_not_empty
}

# trove_git_prefer_ssh (seamed: TROVE_SSH_BIN mocks the auth probe; real git)

@test 'trove_git_prefer_ssh switches an http origin to ssh when the key verifies' {
  trove_log(){ : }
  local d="${TROVE_TEST_DIR}/repo"; git init -q "$d"; git -C "$d" remote add origin "http://git.demo/u/r.git"
  print -l '#!/usr/bin/env bash' 'echo "Hi! successfully authenticated; does not provide shell access." >&2; exit 1' > "${TROVE_TEST_DIR}/ssh_ok"
  chmod +x "${TROVE_TEST_DIR}/ssh_ok"
  TROVE_SSH_BIN="${TROVE_TEST_DIR}/ssh_ok" trove_git_prefer_ssh "$d"
  assert "$(git -C "$d" remote get-url origin)" same_as "ssh://git@git.demo/u/r.git"
}

@test 'trove_git_prefer_ssh leaves an http origin when the key does not verify' {
  trove_log(){ : }
  local d="${TROVE_TEST_DIR}/repo2"; git init -q "$d"; git -C "$d" remote add origin "http://git.demo/u/r.git"
  print -l '#!/usr/bin/env bash' 'echo "Permission denied (publickey)." >&2; exit 255' > "${TROVE_TEST_DIR}/ssh_no"
  chmod +x "${TROVE_TEST_DIR}/ssh_no"
  TROVE_SSH_BIN="${TROVE_TEST_DIR}/ssh_no" trove_git_prefer_ssh "$d"
  assert "$(git -C "$d" remote get-url origin)" same_as "http://git.demo/u/r.git"
}

@test 'trove_git_prefer_ssh is a no-op on an already-ssh origin' {
  trove_log(){ : }
  local d="${TROVE_TEST_DIR}/repo3"; git init -q "$d"; git -C "$d" remote add origin "ssh://git@git.demo/u/r.git"
  run trove_git_prefer_ssh "$d"
  assert $state equals 0
  assert "$(git -C "$d" remote get-url origin)" same_as "ssh://git@git.demo/u/r.git"
}

# trove_ssh_host_from_url — parse the git host out of every URL shape

@test 'trove_ssh_host_from_url parses ssh / scp / http(s) / bare forms (strips port)' {
  assert "$(trove_ssh_host_from_url 'ssh://git@git.demo:2222/u/r.git')" same_as 'git.demo'
  assert "$(trove_ssh_host_from_url 'git@git.demo:u/r.git')"            same_as 'git.demo'
  assert "$(trove_ssh_host_from_url 'https://git.demo/u/r.git')"        same_as 'git.demo'
  assert "$(trove_ssh_host_from_url 'http://git.demo:3000/u/r')"        same_as 'git.demo'
  assert "$(trove_ssh_host_from_url 'git.demo')"                        same_as 'git.demo'
}

@test 'trove_ssh_host_from_url fails on empty / unparseable input' {
  run trove_ssh_host_from_url ''
  assert $state not_equal_to 0
  run trove_ssh_host_from_url 'ftp://nope/x'
  assert $state not_equal_to 0
}

# trove_ssh_verify — match the git-host greeting, not the (non-zero) exit code

@test 'trove_ssh_verify succeeds when the host returns the auth greeting' {
  print -l '#!/usr/bin/env bash' 'echo "Hi! You'\''ve successfully authenticated, but Forgejo does not provide shell access." >&2; exit 1' > "${TROVE_TEST_DIR}/ssh_ok"
  chmod +x "${TROVE_TEST_DIR}/ssh_ok"
  export TROVE_SSH_BIN="${TROVE_TEST_DIR}/ssh_ok"
  run trove_ssh_verify git.demo
  assert $state equals 0
}

@test 'trove_ssh_verify fails on permission denied' {
  print -l '#!/usr/bin/env bash' 'echo "Permission denied (publickey)." >&2; exit 255' > "${TROVE_TEST_DIR}/ssh_no"
  chmod +x "${TROVE_TEST_DIR}/ssh_no"
  export TROVE_SSH_BIN="${TROVE_TEST_DIR}/ssh_no"
  run trove_ssh_verify git.demo
  assert $state not_equal_to 0
}
