#!/usr/bin/env bash
# Trove Installer.
#
# Trove is a zsh utility library plus three CLI facades (klog, kreq, atlas-env).
# This installer is bash-shebanged so it can run on a fresh box that does not yet
# have zsh — it ensures Trove's ONE runtime dependency (zsh) is present, then
# validates the tree, sets permissions, and makes the CLIs reachable.
#
# It does NOT provision the machine beyond that single dependency: no Homebrew,
# Xcode, SSH keys, 1Password, Python venvs, default-shell (`chsh`) changes, or
# Atlas-registry seeding. Those belong to bootstrap/dotFiles. (Installing zsh is
# Trove's own runtime dependency, not machine provisioning — a zsh library has
# to have zsh to load.)

set -e

INSTALL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VERSION="$(cat "${INSTALL_DIR}/VERSION" 2>/dev/null || echo unknown)"

# Minimal bash logging for the installer's own output (the zsh logging library
# can't be sourced from bash before zsh is guaranteed present).
_bot()     { printf '\n  ✪ %s\n' "$1"; }
_running() { printf '   ✨ %s\n' "$1"; }
_ok()      { printf '   ✔ %s\n' "$1"; }
_warn()    { printf '   ⚠ %s\n' "$1" >&2; }
_err()     { printf '   ✖ %s\n' "$1" >&2; }

echo ""
echo "╔════════════════════════════════════════════════════════════╗"
echo "║              Trove — Shared Utilities Library              ║"
printf  "║                        v%-36s║\n" "${VERSION}"
echo "╚════════════════════════════════════════════════════════════╝"
echo ""
echo "Installing from: ${INSTALL_DIR}"

###############################################################################
# Prerequisite: zsh (Trove's own runtime dependency — nothing else)
###############################################################################

_bot "Checking prerequisite: zsh"

if command -v zsh >/dev/null 2>&1; then
    _ok "zsh present: $(command -v zsh)"
else
    _warn "zsh not found — Trove is a zsh library and requires it."
    PLATFORM="$(uname -s)"
    if [[ "$PLATFORM" == "Darwin" ]]; then
        # zsh ships with macOS 10.15+; only an unusual setup reaches here.
        if command -v brew >/dev/null 2>&1; then
            _running "Installing zsh via Homebrew"
            brew install zsh
        else
            _err "Install zsh and re-run (macOS 10.15+ ships zsh by default)."
            exit 1
        fi
    elif [[ "$PLATFORM" == "Linux" ]] && command -v apt-get >/dev/null 2>&1; then
        _running "Installing zsh via apt-get"
        sudo apt-get update -q && sudo apt-get install -y zsh
    elif command -v dnf >/dev/null 2>&1; then
        _running "Installing zsh via dnf"
        sudo dnf install -y zsh
    else
        _err "Could not auto-install zsh on this platform. Install it and re-run."
        exit 1
    fi
    command -v zsh >/dev/null 2>&1 || { _err "zsh still not available after install."; exit 1; }
    _ok "zsh installed: $(command -v zsh)"
fi

# NOTE: we intentionally do NOT change the default shell (chsh). That is a user
# / dotFiles decision, not Trove's.

###############################################################################
# Validate the tree
###############################################################################

_bot "Validating Trove tree"

for dir in bin lib; do
    [[ -d "${INSTALL_DIR}/${dir}" ]] || { _err "Missing directory: ${dir}"; exit 1; }
done
_ok "Directory structure valid"

required_files=(
    "lib/trove_logging.zsh"
    "lib/trove_colors.zsh"
    "lib/trove_helpers.zsh"
    "lib/trove_atlas.zsh"
    "lib/trove_init.zsh"
    "bin/klog"
    "bin/kreq"
    "bin/atlas-env"
    "VERSION"
)
for file in "${required_files[@]}"; do
    [[ -f "${INSTALL_DIR}/${file}" ]] || { _err "Missing file: ${file}"; exit 1; }
done
_ok "Required files present"

###############################################################################
# Permissions
###############################################################################

_bot "Setting permissions"

chmod +x "${INSTALL_DIR}"/bin/klog "${INSTALL_DIR}"/bin/kreq "${INSTALL_DIR}"/bin/atlas-env
_ok "klog, kreq, atlas-env are executable"

chmod 644 "${INSTALL_DIR}"/lib/*.zsh
_ok "Library files set to 644"

###############################################################################
# Smoke test (runs under zsh, which is now guaranteed present)
###############################################################################

_bot "Verifying installation"

if zsh -c "source '${INSTALL_DIR}/lib/trove_init.zsh' 2>/dev/null; (( \${+functions[trove_atlas_get]} ))"; then
    _ok "Core loads; Atlas reader present"
else
    _err "Trove core failed to load under zsh"
    exit 1
fi

if "${INSTALL_DIR}/bin/klog" --help >/dev/null 2>&1; then
    _ok "klog facade works"
else
    _err "klog failed"
    exit 1
fi

###############################################################################
# Make the CLIs reachable
###############################################################################

_bot "Making the CLIs reachable"

LINK_DIR=""
for candidate in /usr/local/bin "${HOME}/.local/bin"; do
    if [[ -d "$candidate" && -w "$candidate" ]]; then
        LINK_DIR="$candidate"
        break
    fi
done

if [[ -n "$LINK_DIR" ]]; then
    for cli in klog kreq atlas-env; do
        ln -sf "${INSTALL_DIR}/bin/${cli}" "${LINK_DIR}/${cli}"
    done
    _ok "Symlinked klog, kreq, atlas-env into ${LINK_DIR}"
else
    echo ""
    echo "  No writable standard bin dir found. Add Trove to your PATH:"
    echo "    export PATH=\"${INSTALL_DIR}/bin:\$PATH\""
fi

###############################################################################
# Prefer SSH origin (opportunistic — only if your key already authenticates)
###############################################################################

_bot "Git remote"
zsh -c "source '${INSTALL_DIR}/lib/trove_init.zsh' 2>/dev/null; trove_load helpers 2>/dev/null; trove_git_prefer_ssh '${INSTALL_DIR}'" || true

###############################################################################
# Done
###############################################################################

echo ""
echo "  ✅ Trove ${VERSION} installed."
echo ""
echo "  Source the core in your shell (or via your dotfiles):"
echo "    source \"${INSTALL_DIR}/lib/trove_init.zsh\""
echo ""
echo "  CLIs:  klog INFO \"message\"  ·  kreq check zsh  ·  atlas-env"
echo "  Docs:  ${INSTALL_DIR}/README.md · ${INSTALL_DIR}/docs/API.md"
echo ""
